{
  "name": "@ummat/praycalc-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "PrayCalc — React Native + Expo SDK 53 prayer times app",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build": "eas build --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "@acamarata/pray-calc": "workspace:*",
    "@bacons/apple-targets": "^4.0.7",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@sentry/react-native": "^6.3.0",
    "@umalqura/core": "^0.0.7",
    "@urql/exchange-auth": "^3.0.0",
    "expo": "~53.0.0",
    "expo-background-fetch": "~13.0.0",
    "expo-calendar": "~14.0.0",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.0",
    "expo-in-app-purchases": "~14.5.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-localization": "~16.0.0",
    "expo-location": "~18.0.0",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sensors": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-store-review": "~8.0.0",
    "expo-system-ui": "~4.0.0",
    "expo-task-manager": "~12.0.0",
    "expo-updates": "~0.28.18",
    "geomagnetism": "^0.2.0",
    "graphql": "^16.10.0",
    "i18next": "^23.15.2",
    "pray-calc": "^2.1.2",
    "react": "^19.1.0",
    "react-i18next": "^15.1.2",
    "react-native": "^0.81.0",
    "react-native-android-widget": "0.17.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "~5.3.0",
    "react-native-screens": "~4.10.0",
    "react-native-track-player": "^4.1.1",
    "react-native-volume-manager": "^2.0.8",
    "urql": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "@types/react-native": "~0.73.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.6.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!.*node_modules/)(?!(?:(jest-)?react-native|@react-native/.*|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ]
  }
}
