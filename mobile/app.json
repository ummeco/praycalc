{
  "expo": {
    "name": "PrayCalc",
    "slug": "praycalc",
    "owner": "ummeco",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "praycalc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E5E2F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.praycalc.praycalcApp",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.praycalc.praycalcApp"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Prayer Times to access your location to calculate accurate prayer times.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Prayer Times to access your location to calculate accurate prayer times.",
        "NSCalendarsFullAccessUsageDescription": "Prayer Times adds salah blocks to your calendar as reminders.",
        "NSFaceIDUsageDescription": "Prayer Times uses Face ID to confirm lock-on-salah mode.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E5E2F"
      },
      "package": "com.praycalc.praycalcApp",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Prayer Times to access your location to calculate accurate prayer times."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Prayer Times to access the compass for Qibla direction."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E5E2F",
          "defaultChannel": "prayer-alarm",
          "sounds": [
            "./assets/sounds/adhan_takbir.wav"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Prayer Times uses Face ID to confirm lock-on-salah mode."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Prayer Times adds salah blocks to your calendar as reminders."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextPrayer",
              "label": "Next Prayer",
              "description": "Shows the next prayer time and city at a glance.",
              "minWidth": "180dp",
              "minHeight": "48dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./src/i18n/en.json",
      "ar": "./src/i18n/ar.json",
      "fr": "./src/i18n/fr.json",
      "ur": "./src/i18n/ur.json",
      "tr": "./src/i18n/tr.json",
      "id": "./src/i18n/id.json",
      "ms": "./src/i18n/ms.json",
      "bn": "./src/i18n/bn.json",
      "sw": "./src/i18n/sw.json",
      "es": "./src/i18n/es.json",
      "de": "./src/i18n/de.json",
      "nl": "./src/i18n/nl.json",
      "pt": "./src/i18n/pt.json",
      "it": "./src/i18n/it.json",
      "ru": "./src/i18n/ru.json",
      "hi": "./src/i18n/hi.json",
      "ps": "./src/i18n/ps.json",
      "fa": "./src/i18n/fa.json",
      "so": "./src/i18n/so.json",
      "ha": "./src/i18n/ha.json",
      "yo": "./src/i18n/yo.json"
    },
    "extra": {
      "eas": {
        "projectId": "UD-PENDING-EAS-PROJECT-ID"
      },
      "graphqlUrl": "https://api.ummat.dev/v1/graphql",
      "authUrl": "https://auth.ummat.dev"
    }
  }
}
