# PrayCalc Smart Service — Environment Variables
# Copy to .env and fill in values

# Server
PORT=4010
NODE_ENV=production

# Hasura (shared Ummat backend)
HASURA_GRAPHQL_URL=http://hasura:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=
HASURA_GRAPHQL_JWT_SECRET=
HASURA_AUTH_URL=http://auth:4000

# Stripe (Ummat+ subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_1T8hVuRlT87D7DYdme8Qvs3Z
