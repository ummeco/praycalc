# Metro (Expo/React Native) cannot resolve transitive deps through pnpm's isolated
# symlink layout. Full hoisting (node-linker=hoisted) is also wrong here: it collapses
# the workspace onto ONE React while surfaces legitimately pin different Reacts
# (mobile: 19.0.0 per Expo SDK 53; web/org: 19.1+). shamefully-hoist keeps pnpm's
# isolated per-project resolution (each app gets ITS declared versions) while also
# exposing a flat root node_modules that satisfies Metro's transitive lookups.
shamefully-hoist=true
