{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrayCalc",
  "version": "1.2.4",
  "identifier": "com.praycalc.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PrayCalc",
        "width": 360,
        "height": 520,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://praycalc.com https://auth.ummat.dev https://api.praycalc.com https://smart.praycalc.com https://ipapi.co ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ummeco/praycalc/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNDI1NzJBQUNFQzg3MUEKUldRYWgreXNLbGRDSTRmeDE4bGNNR1l3SkttTGpVNFR6anViZmhDcWM3cjYwTWRNNW5rREtqUkwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
