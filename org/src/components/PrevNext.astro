---
// FILE: src/components/PrevNext.astro
// PURPOSE: Previous / Next page navigation footer cards.
//   Flattens the navigation link order; given currentPath finds the adjacent pages;
//   renders two arrow cards (← prev / next →) like the Protocol template footer pager.
//   Server-rendered — no island needed.
// INPUTS: currentPath (string)
// CONSTRAINTS: No next/* imports. Plain <a> tags.
// REF: Epic B-2

import { navigation } from '../lib/navigation';
import type { NavLink } from '../lib/navigation';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Normalize path for comparison
function normalize(p: string): string {
  return p.replace(/\/$/, '') || '/';
}

const allLinks: NavLink[] = navigation.flatMap((g) => g.links);
const normalPath = normalize(currentPath);

const currentIndex = allLinks.findIndex((link) => normalize(link.href) === normalPath);
const prevLink = currentIndex > 0 ? allLinks[currentIndex - 1] : null;
const nextLink = currentIndex !== -1 && currentIndex < allLinks.length - 1 ? allLinks[currentIndex + 1] : null;
---

{(prevLink || nextLink) && (
  <div class="mt-16 flex flex-col gap-4 border-t border-zinc-200 pt-8 dark:border-zinc-800 sm:flex-row sm:items-stretch sm:justify-between">
    {prevLink ? (
      <a
        href={prevLink.href}
        class="group flex flex-1 flex-col gap-1 rounded-xl border border-zinc-200 p-5 transition-shadow hover:shadow-md dark:border-zinc-800 dark:hover:border-zinc-700 sm:max-w-[50%]"
        rel="prev"
      >
        <span class="flex items-center gap-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M14 8a.75.75 0 01-.75.75H3.56l3.22 3.22a.75.75 0 11-1.06 1.06l-4.5-4.5a.75.75 0 010-1.06l4.5-4.5a.75.75 0 011.06 1.06L3.56 7.25H13.25A.75.75 0 0114 8z" clip-rule="evenodd" />
          </svg>
          Previous
        </span>
        <span class="font-semibold text-zinc-900 transition group-hover:text-green-700 dark:text-white dark:group-hover:text-green-400">
          {prevLink.title}
        </span>
      </a>
    ) : (
      <div class="flex-1 sm:max-w-[50%]" />
    )}

    {nextLink && (
      <a
        href={nextLink.href}
        class="group flex flex-1 flex-col items-end gap-1 rounded-xl border border-zinc-200 p-5 text-right transition-shadow hover:shadow-md dark:border-zinc-800 dark:hover:border-zinc-700 sm:max-w-[50%]"
        rel="next"
      >
        <span class="flex items-center gap-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">
          Next
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 8a.75.75 0 01.75-.75h9.69L9.22 4.03a.75.75 0 011.06-1.06l4.5 4.5a.75.75 0 010 1.06l-4.5 4.5a.75.75 0 01-1.06-1.06l3.22-3.22H2.75A.75.75 0 012 8z" clip-rule="evenodd" />
          </svg>
        </span>
        <span class="font-semibold text-zinc-900 transition group-hover:text-green-700 dark:text-white dark:group-hover:text-green-400">
          {nextLink.title}
        </span>
      </a>
    )}
  </div>
)}
