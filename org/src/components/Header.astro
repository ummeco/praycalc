---
// FILE: src/components/Header.astro
// PURPOSE: Sticky top-bar — Protocol parity, green-tuned.
//   Left: PrayCalc logo mark + wordmark (link to /).
//   Right: top-level nav (Science / Packages / GitHub), divider, search trigger
//          (dispatches 'open-search' + Cmd/Ctrl+K), ThemeToggle island,
//          MobileNavToggle trigger.
//   Scroll-driven background: transparent-ish at top, blurs + gains a hairline
//   bottom border once the page scrolls (Protocol's scroll opacity behaviour).
// INPUTS: navigation (NavGroup[]), currentPath (string)
// OUTPUTS: <header> element with sticky positioning and scroll-driven blur
// CONSTRAINTS: no next.js imports; scroll bg via inline script + .header-scrolled
// REF: Epic B-1 · Protocol re-skin (36996b7~1: Header.tsx, Logo.tsx)

import Logo from './Logo.astro';
import ThemeToggle from './islands/ThemeToggle';
import MobileNavToggle from './islands/MobileNavToggle';
import type { NavGroup } from '../lib/navigation';

interface Props {
  navigation: NavGroup[];
  currentPath: string;
}

const { navigation, currentPath } = Astro.props;
---

<header
  id="site-header"
  class="sticky top-0 z-40 flex h-14 w-full items-center justify-between gap-8 border-b border-transparent px-4 backdrop-blur-sm transition-all sm:px-6"
>
  <!-- Left: logo mark + wordmark -->
  <a
    href="/"
    class="flex shrink-0 items-center gap-2"
    aria-label="PrayCalc docs home"
  >
    <Logo class="h-6 w-auto" />
    <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[0.7rem] font-medium text-emerald-700 ring-1 ring-inset ring-emerald-500/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/20">
      docs
    </span>
  </a>

  <!-- Right controls -->
  <div class="flex items-center gap-5">
    <!-- Top-level nav (desktop) — Protocol parity -->
    <nav class="hidden md:block">
      <ul class="flex items-center gap-8">
        <li>
          <a href="/science/solar-position" class="text-sm/5 text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Science</a>
        </li>
        <li>
          <a href="/packages/pray-calc" class="text-sm/5 text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Packages</a>
        </li>
        <li>
          <a href="https://github.com/acamarata" class="text-sm/5 text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">GitHub</a>
        </li>
      </ul>
    </nav>

    <div class="hidden md:block md:h-5 md:w-px md:bg-zinc-900/10 md:dark:bg-white/15"></div>

    <div class="flex items-center gap-1">
      <!-- Search trigger (desktop) -->
      <button
        id="search-trigger"
        type="button"
        class="hidden items-center gap-2 rounded-lg bg-zinc-100 px-3 py-1.5 text-sm text-zinc-600 ring-1 ring-zinc-900/10 transition hover:ring-zinc-900/20 dark:bg-white/5 dark:text-zinc-400 dark:ring-inset dark:ring-white/10 dark:hover:ring-white/20 sm:flex"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 11a4.5 4.5 0 100-9 4.5 4.5 0 000 9zM14 14l-3-3" />
        </svg>
        <span>Search docs...</span>
        <kbd
          aria-hidden="true"
          class="ml-2 hidden rounded border border-zinc-300 bg-white px-1 py-0.5 font-mono text-[0.65rem] text-zinc-600 dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-400 lg:inline"
        >
          ⌘K
        </kbd>
      </button>

      <!-- Mobile search icon-only button -->
      <button
        id="search-trigger-mobile"
        type="button"
        aria-label="Search docs"
        class="flex items-center justify-center rounded-md p-1.5 text-zinc-600 transition hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-white/5 sm:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 11a4.5 4.5 0 100-9 4.5 4.5 0 000 9zM14 14l-3-3" />
        </svg>
      </button>

      <!-- Theme toggle island (deferred — pre-hydration CSS already reflects the
           persisted theme via Base.astro's no-flash script, so idle hydration
           causes no visual change, only a lower TBT contribution) -->
      <ThemeToggle client:idle />

      <!-- Mobile nav toggle (hidden on desktop — desktop uses sidebar) -->
      <div class="lg:hidden">
        <MobileNavToggle navigation={navigation} currentPath={currentPath} client:idle />
      </div>
    </div>
  </div>
</header>

<!-- No-JS navigation fallback (<lg only) — the desktop sidebar is `hidden lg:block`
     and the mobile drawer is a `client:idle` React island, so a visitor with
     JavaScript disabled otherwise has zero navigation below the lg breakpoint.
     Browsers only parse/render <noscript> contents when scripting is disabled,
     so this <details> menu never appears (and never flashes) for anyone whose
     JS runs — MobileNavToggle owns mobile nav for everyone else. -->
<noscript>
  <details class="border-b border-zinc-900/10 px-4 py-2 lg:hidden dark:border-white/10">
    <summary class="cursor-pointer list-none px-2 py-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">
      Menu
    </summary>
    <nav aria-label="Navigation (no-script fallback)" class="mt-2 pb-3">
      <ul class="space-y-6">
        {navigation.map((group) => (
          <li>
            <p class="mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
              {group.title}
            </p>
            <ul class="space-y-0.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={currentPath === link.href ? 'page' : undefined}
                    class="block rounded-md px-3 py-1 text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
                  >
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </nav>
  </details>
</noscript>

<!-- Search trigger wiring + scroll-driven header background -->
<script is:inline>
  (function () {
    function openSearch() {
      window.dispatchEvent(new CustomEvent('open-search'));
    }
    ['search-trigger', 'search-trigger-mobile'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('click', openSearch);
    });
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      }
    });

    // Protocol scroll-blur: solidify header background once scrolled past 32px.
    var header = document.getElementById('site-header');
    if (header) {
      var onScroll = function () {
        if (window.scrollY > 32) header.classList.add('header-scrolled');
        else header.classList.remove('header-scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  })();
</script>
