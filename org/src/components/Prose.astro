---
// FILE: src/components/Prose.astro
// PURPOSE: Applies Tailwind Typography prose styles to MDX content.
//   Used as the wrapping element in MDX pages for consistent typography.
// REF: T-01 (P2-E3-W01-S01)

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['prose prose-zinc max-w-3xl dark:prose-invert prose-a:text-green-700 dark:prose-a:text-green-400 prose-headings:scroll-mt-20 prose-code:before:content-none prose-code:after:content-none', className]}>
  <slot />
</div>
