---
// FILE: src/pages/index.astro
// PURPOSE: PrayCalc.org homepage — introduction page with Protocol hero pattern,
//   DPC flagship block, live-calculator CTA, and section cards.
// REF: T-01 (P2-E3-W01-S01) · Protocol re-skin (36996b7~1)

import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import HeroPattern from '../components/HeroPattern.astro';
import DocsSidebar from '../components/islands/DocsSidebar';
import { navigation } from '../lib/navigation';

const title = 'Introduction';
const description = 'Scientific documentation for PrayCalc — solar physics, twilight optics, orbital mechanics, and npm packages for Islamic prayer time calculation.';
---

<Base title={title} description={description}>
  <div class="flex min-h-screen w-full flex-col">
    <!-- Sticky header (Epic B-1) -->
    <Header navigation={navigation} currentPath="/" />

    <div class="flex flex-1 flex-col lg:flex-row">
      <!-- Sidebar (desktop) -->
      <aside
        class="hidden w-72 shrink-0 border-r border-zinc-900/10 dark:border-white/10 lg:block"
        aria-label="Documentation navigation"
      >
        <div class="sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto px-4 py-8">
          <DocsSidebar
            client:load
            navigation={navigation}
            currentPath="/"
          />
        </div>
      </aside>

    <!-- Main -->
    <main class="relative min-w-0 flex-1 overflow-hidden px-4 py-10 sm:px-6 lg:px-10 xl:px-16" id="main-content">
      <!-- Protocol signature hero pattern behind the intro -->
      <HeroPattern />

      <!-- Hero -->
      <div class="relative mb-12">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-500/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/20">
          Open Source · Islamic Technology
        </div>
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-5xl">
          The Science of Islamic<br />Prayer Times
        </h1>
        <p class="max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
          PrayCalc is an open-source Islamic prayer time calculator built on rigorous astronomical science. Its default method, DPC, computes the best Fajr and Isha times for any location on Earth.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/how-dpc-works"
            class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-zinc-700 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-1 dark:ring-inset dark:ring-emerald-400/20 dark:hover:bg-emerald-400/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500"
          >
            How DPC Works
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M2 8a.75.75 0 01.75-.75h8.69L8.22 4.03a.75.75 0 011.06-1.06l4.5 4.5a.75.75 0 010 1.06l-4.5 4.5a.75.75 0 01-1.06-1.06l3.22-3.22H2.75A.75.75 0 012 8z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="/science/solar-position"
            class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-zinc-700 ring-1 ring-inset ring-zinc-900/10 transition hover:bg-zinc-50 hover:ring-zinc-900/20 dark:text-zinc-200 dark:ring-white/10 dark:hover:bg-white/5 dark:hover:ring-white/20"
          >
            Start with Solar Position
          </a>
        </div>
      </div>

      <!-- DPC hero: the flagship default method -->
      <section
        id="dpc"
        aria-labelledby="dpc-heading"
        class="relative mb-16 overflow-hidden rounded-2xl bg-zinc-50 p-6 ring-1 ring-inset ring-zinc-900/7.5 sm:p-8 dark:bg-white/2.5 dark:ring-white/10"
      >
        <!-- subtle brand glow in the corner -->
        <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-gradient-to-br from-emerald-400/20 to-emerald-300/5 blur-2xl" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-emerald-500 px-3 py-1 text-xs font-semibold text-white shadow-sm dark:bg-emerald-400/15 dark:text-emerald-300 dark:ring-1 dark:ring-inset dark:ring-emerald-400/20">
            Default Method
          </div>
          <h2 id="dpc-heading" class="mb-3 text-2xl font-bold text-zinc-900 dark:text-white">
            DPC — Dynamic Prayer Calculation
          </h2>
          <p class="mb-4 max-w-3xl text-zinc-700 dark:text-zinc-300">
            Fixed methods use one twilight angle for the whole world. DPC works out the right angle for
            your latitude, your season, and the Earth's current distance from the Sun. It takes what every
            earlier method learned and folds it into a single calculation that adapts to where and when you are.
          </p>
          <p class="mb-5 max-w-3xl text-zinc-700 dark:text-zinc-300">
            It is similar to the Moonsighting Committee method, and improved over it. DPC follows the same
            idea of prayer times that shift with the season, then smooths out the seasonal steps and adds an
            Earth-Sun distance correction. Where DPC's training data is sparse, we say so plainly.
          </p>
          <div class="flex flex-wrap gap-4 text-sm">
            <a href="/how-dpc-works" class="font-medium text-emerald-700 underline decoration-emerald-500/30 underline-offset-2 hover:decoration-emerald-500/60 dark:text-emerald-400">
              Read how DPC works
            </a>
            <a href="/science/dynamic-vs-fixed" class="text-zinc-600 underline decoration-zinc-300 underline-offset-2 hover:text-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-white">
              Dynamic vs. fixed angles
            </a>
            <a href="/research/empirical-studies" class="text-zinc-600 underline decoration-zinc-300 underline-offset-2 hover:text-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-white">
              The research behind it
            </a>
          </div>
        </div>
      </section>

      <!-- Live calculator CTA -->
      <div class="mb-16 flex flex-col gap-4 rounded-2xl bg-zinc-50 p-6 ring-1 ring-inset ring-zinc-900/7.5 sm:flex-row sm:items-center sm:justify-between dark:bg-white/2.5 dark:ring-white/10">
        <div>
          <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Try the live calculator</h2>
          <p class="mt-1 max-w-xl text-sm text-zinc-600 dark:text-zinc-400">
            Compute prayer times for any location and date — all 14 methods, dynamic angles, and the Hijri calendar — in your browser.
          </p>
        </div>
        <a
          href="https://praycalc.com"
          class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500 sm:self-auto"
        >
          Open praycalc.com
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 8a.75.75 0 01.75-.75h8.69L8.22 4.03a.75.75 0 011.06-1.06l4.5 4.5a.75.75 0 010 1.06l-4.5 4.5a.75.75 0 01-1.06-1.06l3.22-3.22H2.75A.75.75 0 012 8z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <!-- Section cards -->
      <section id="science" aria-labelledby="science-heading">
        <h2 id="science-heading" class="mb-6 text-2xl font-bold text-zinc-900 dark:text-white">The Science</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            { href: '/science/solar-position', title: 'Solar Position & NREL SPA', desc: 'Sub-arcsecond solar position using NREL SPA — the foundation of all prayer time calculations.' },
            { href: '/science/twilight-angles', title: 'Twilight & Depression Angles', desc: 'How depression angles determine Fajr and Isha — the physics of astronomical twilight.' },
            { href: '/science/calculation-methods', title: 'Calculation Methods', desc: 'The 14 standard Islamic calculation methods — Fajr/Isha angles, organizations, and regions.' },
            { href: '/science/qibla-calculation', title: 'Qibla Direction', desc: 'Great-circle bearing to the Kaaba using spherical trigonometry.' },
          ].map((card) => (
            <a
              href={card.href}
              class="group relative overflow-hidden rounded-2xl bg-zinc-50 p-6 ring-1 ring-inset ring-zinc-900/7.5 transition hover:ring-zinc-900/15 dark:bg-white/2.5 dark:ring-white/10 dark:hover:ring-white/20"
            >
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-emerald-400/0 to-emerald-400/0 opacity-0 transition-opacity duration-300 group-hover:from-emerald-400/5 group-hover:to-emerald-300/0 group-hover:opacity-100" aria-hidden="true"></div>
              <h3 class="relative mb-1 font-semibold text-zinc-900 transition group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">
                {card.title}
              </h3>
              <p class="relative text-sm text-zinc-600 dark:text-zinc-400">{card.desc}</p>
            </a>
          ))}
        </div>
      </section>

      <section id="packages" class="mt-12" aria-labelledby="packages-heading">
        <h2 id="packages-heading" class="mb-6 text-2xl font-bold text-zinc-900 dark:text-white">Packages</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            { href: '/packages/pray-calc', title: 'pray-calc', desc: 'Main prayer times engine. 14 methods, dynamic angles, TypeScript-first.' },
            { href: '/packages/nrel-spa', title: 'nrel-spa', desc: 'Pure JS port of the NREL Solar Position Algorithm — sub-arcsecond precision.' },
            { href: '/packages/hijri-core', title: 'hijri-core', desc: 'Hijri ↔ Gregorian conversion. Umm al-Qura and civil algorithms.' },
            { href: '/packages/moon-sighting', title: 'moon-sighting', desc: 'Lunar crescent visibility calculation for Hilal determination.' },
          ].map((card) => (
            <a
              href={card.href}
              class="group relative overflow-hidden rounded-2xl bg-zinc-50 p-6 ring-1 ring-inset ring-zinc-900/7.5 transition hover:ring-zinc-900/15 dark:bg-white/2.5 dark:ring-white/10 dark:hover:ring-white/20"
            >
              <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>
              <h3 class="relative mb-1 font-mono text-sm font-semibold text-emerald-700 group-hover:text-emerald-600 dark:text-emerald-400 dark:group-hover:text-emerald-300">
                {card.title}
              </h3>
              <p class="relative text-sm text-zinc-600 dark:text-zinc-400">{card.desc}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Attribution -->
      <p class="mt-16 text-sm text-zinc-500 dark:text-zinc-500">
        PrayCalc was built by{' '}
        <a href="https://alicamarata.com" class="text-zinc-600 underline decoration-zinc-300 underline-offset-2 hover:text-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-white">
          Ali Camarata
        </a>{' '}
        — an independent developer focused on Islamic technology. The underlying packages are open source and used to power{' '}
        <a href="https://praycalc.com" class="text-zinc-600 underline decoration-zinc-300 underline-offset-2 hover:text-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-white">
          praycalc.com
        </a>{' '}
        and the{' '}
        <a href="https://ummat.app" class="text-zinc-600 underline decoration-zinc-300 underline-offset-2 hover:text-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-white">
          Ummat
        </a>{' '}
        super-app.
      </p>
    </main>
    </div>
  </div>
</Base>
