---
// FILE: src/pages/ur/index.astro
// PURPOSE: Urdu language homepage for praycalc.org.
//   RTL layout — html dir="rtl" set via locale='ur' in Base layout.
//   Stub page linking to full English documentation.
// CONSTRAINTS:
//   - locale='ur' triggers RTL in Base.astro (isRtl check covers ar/ur/fa)
//   - Noto Nastaliq Urdu font active for this route via CSS variable
// REF: P2-E6-W01-S01-T01 AC-01 / AC-02

import Base from '../../layouts/Base.astro';

const locale = 'ur';
const title = 'PrayCalc — نماز اوقات دستاویزی';
const description = 'PrayCalc کے لیے سائنسی دستاویزات — اسلامی نماز کے اوقات کا حساب فلکیاتی اصولوں پر۔';
---

<Base title={title} description={description} locale={locale}>
  <main class="min-w-0 flex-1 px-4 py-10 sm:px-6 lg:px-10 xl:px-16" id="main-content" dir="rtl" lang="ur">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:right-2 focus:z-[100] focus:rounded-md focus:bg-green-700 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      مرکزی مواد پر جائیں
    </a>

    <div class="mb-12">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-800 ring-1 ring-green-200 dark:bg-green-950 dark:text-green-300 dark:ring-green-900">
        اوپن سورس · اسلامی ٹیکنالوجی
      </div>
      <h1 class="mb-4 text-4xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-5xl">
        اسلامی نماز اوقات کا علم
      </h1>
      <p class="max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
        PrayCalc ایک اوپن سورس اسلامی نماز وقت کیلکولیٹر ہے جو درست سائنسی بنیادوں پر بنایا گیا ہے — NREL شمسی مقام الگورتھم، JPL فلکیاتی ڈیٹا، اور مشین لرننگ۔
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-green-800"
        >
          انگریزی دستاویزات
        </a>
        <a
          href="/ar"
          class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-medium text-zinc-700 shadow-sm ring-1 ring-zinc-200 hover:bg-zinc-50 dark:bg-zinc-900 dark:text-zinc-200 dark:ring-zinc-700"
        >
          عربی دستاویزات
        </a>
      </div>
    </div>

    <p class="mt-8 text-sm text-zinc-400">
      مکمل تکنیکی دستاویزات فی الحال صرف انگریزی میں دستیاب ہیں۔
      <a href="/" class="underline hover:text-zinc-600">English documentation available here</a>
    </p>
  </main>
</Base>
