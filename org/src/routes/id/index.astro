---
// FILE: src/pages/id/index.astro
// PURPOSE: Indonesian language homepage for praycalc.org.
//   LTR layout — Indonesian is an LTR language.
//   Stub page linking to full English documentation.
// CONSTRAINTS:
//   - locale='id' — LTR (not in RTL set)
// REF: P2-E6-W01-S01-T01 AC-01

import Base from '../../layouts/Base.astro';

const locale = 'id';
const title = 'PrayCalc — Dokumentasi Waktu Sholat';
const description = 'Dokumentasi ilmiah untuk PrayCalc — perhitungan waktu sholat Islam berdasarkan astronomi yang akurat.';
---

<Base title={title} description={description} locale={locale}>
  <main class="min-w-0 flex-1 px-4 py-10 sm:px-6 lg:px-10 xl:px-16" id="main-content">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-green-700 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Langsung ke konten utama
    </a>

    <div class="mb-12">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-800 ring-1 ring-green-200 dark:bg-green-950 dark:text-green-300 dark:ring-green-900">
        Sumber Terbuka · Teknologi Islam
      </div>
      <h1 class="mb-4 text-4xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-5xl">
        Ilmu Pengetahuan Waktu Sholat Islam
      </h1>
      <p class="max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
        PrayCalc adalah kalkulator waktu sholat Islam sumber terbuka, dibangun di atas dasar ilmiah yang akurat — algoritma posisi matahari NREL, data astronomi JPL, dan pembelajaran mesin.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/science/solar-position"
          class="inline-flex items-center gap-2 rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-green-800"
        >
          Mulai dengan Posisi Matahari
        </a>
        <a
          href="/installation"
          class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-medium text-zinc-700 shadow-sm ring-1 ring-zinc-200 hover:bg-zinc-50 dark:bg-zinc-900 dark:text-zinc-200 dark:ring-zinc-700"
        >
          Instalasi Paket
        </a>
      </div>
    </div>

    <p class="mt-8 text-sm text-zinc-400">
      Dokumentasi teknis lengkap saat ini hanya tersedia dalam bahasa Inggris.
      <a href="/" class="underline hover:text-zinc-600">English documentation available here</a>
    </p>
  </main>
</Base>
