---
// FILE: src/layouts/DocPage.astro
// PURPOSE: Layout wrapper for all .mdx documentation pages.
//   Provides sidebar nav + prose content area + TOC right-rail for MDX content.
// INPUTS: frontmatter (title, description, locale from MDX)
// CONSTRAINTS:
//   - All MDX pages set layout: '../../../layouts/DocPage.astro' in frontmatter
//   - Prose area uses Tailwind Typography for content rendering
//   - DocsSidebar replaces static SidebarNav (Epic B-2)
//   - 3-column grid on xl: [sidebar | main | TOC]
// REF: T-01 (P2-E3-W01-S01) · Epic B-2

import Base from './Base.astro';
import Header from '../components/Header.astro';
import DocsSidebar from '../components/islands/DocsSidebar';
import TableOfContents from '../components/islands/TableOfContents';
import Feedback from '../components/islands/Feedback';
import PrevNext from '../components/PrevNext.astro';
import { navigation } from '../lib/navigation';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    locale?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description, locale = 'en' } = frontmatter;
---

<Base title={title} description={description} locale={locale}>
  <div class="flex min-h-screen w-full flex-col">
    <!-- Sticky header (Epic B-1) -->
    <Header navigation={navigation} currentPath={Astro.url.pathname} />

    <div class="flex flex-1 flex-col lg:flex-row">
      <!-- Sidebar (desktop) — Epic B-2: DocsSidebar island replaces static SidebarNav -->
      <aside
        class="hidden w-72 shrink-0 border-r border-zinc-900/10 dark:border-white/10 lg:block"
        aria-label="Documentation navigation"
      >
        <div class="sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto px-4 py-8">
          <DocsSidebar
            client:idle
            navigation={navigation}
            currentPath={Astro.url.pathname}
          />
        </div>
      </aside>

      <!-- Main content -->
      <main class="min-w-0 flex-1 px-4 py-10 sm:px-6 lg:px-10 xl:px-16" id="main-content">
        <article
          class="prose prose-zinc max-w-3xl dark:prose-invert prose-a:text-green-700 dark:prose-a:text-green-400 prose-headings:scroll-mt-20 prose-code:before:content-none prose-code:after:content-none"
          lang={locale}
        >
          <slot />
        </article>

        <!-- Feedback widget (Epic B-2) -->
        <Feedback client:visible />

        <!-- Prev/Next pager (Epic B-2) -->
        <PrevNext currentPath={Astro.url.pathname} />
      </main>

      <!-- On-page TOC right rail (Epic B-2, xl only) -->
      <div class="hidden xl:block xl:w-56 xl:shrink-0">
        <TableOfContents client:idle />
      </div>
    </div>
  </div>
</Base>
