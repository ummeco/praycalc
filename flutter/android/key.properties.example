# Android release signing — copy to key.properties and fill in real values.
# key.properties is gitignored. key.properties.example IS tracked.
#
# Local dev: fill in values here.
# CI: set env vars SIGNING_STORE_FILE, SIGNING_STORE_PASSWORD, SIGNING_KEY_ALIAS,
#     SIGNING_KEY_PASSWORD instead (env vars take priority over this file).
#
# storeFile is relative to android/app/ (the build.gradle.kts project directory).
storeFile=upload-keystore.jks
storePassword=REPLACE_WITH_STRONG_PASSWORD
keyAlias=praycalc
keyPassword=REPLACE_WITH_STRONG_PASSWORD
