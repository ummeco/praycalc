# praycalc/flutter — environment variables
# Copy to .env and fill in values for local development

# Backend
HASURA_URL=https://api.praycalc.com/v1/graphql
AUTH_URL=https://auth.ummat.dev

# nSelf notify push endpoint (server-side only — Flutter proxies via web API)
NSELF_PUSH_ENDPOINT=https://api.ummat.dev/plugins/notify/push

# Voice assistant project IDs
GOOGLE_ACTIONS_PROJECT_ID=  # from vault: PRAYCALC_GOOGLE_ACTIONS_PROJECT_ID
ALEXA_SKILL_ID=              # from vault: PRAYCALC_ALEXA_SKILL_ID

# ─── v1.1 Feature Flags ───────────────────────────────────────────────────────
# Read from pc_feature_flags table at runtime (nSelf cache TTL 60s)
# Local overrides only — production reads from DB
FF_LIVE_ACTIVITY=true    # iOS 16.1+ — ActivityKit countdown
FF_APPLE_WATCH=true      # watchOS 9+ (D-S19-01: free, competitive parity)
FF_WEAROS=true           # WearOS 3+ (D-S19-08: paired phone mode)
FF_DESKTOP_TRAY=true     # macOS 12+ / Windows 10+ (D-S19-02: free)
FF_TV=true               # Android TV 9+ / tvOS 15+
FF_SMART_HOME=false      # Ummat+ gate (D-S19-03: premium)
FF_ALEXA=true            # Alexa skill live
FF_GOOGLE_ACTIONS=true   # Google Actions live
