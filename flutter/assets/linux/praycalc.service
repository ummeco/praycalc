# systemd user service for PrayCalc desktop auto-restart on crash.
#
# Installation:
#   mkdir -p ~/.config/systemd/user/
#   cp praycalc.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable praycalc.service
#   systemctl --user start praycalc.service
#
# Check status:
#   systemctl --user status praycalc.service
#
# View logs:
#   journalctl --user -u praycalc.service -f
#
# Stop and disable:
#   systemctl --user stop praycalc.service
#   systemctl --user disable praycalc.service

[Unit]
Description=PrayCalc - Islamic Prayer Times
Documentation=https://praycalc.com
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/praycalc_app
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
