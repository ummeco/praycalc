<!--
  macOS launchd plist for PrayCalc auto-launch at login with crash recovery.

  This plist is for the SwiftUI macOS app. It registers PrayCalc as a
  LaunchAgent that starts automatically when the user logs in and restarts
  on crash (KeepAlive = true).

  Installation:
    cp com.praycalc.app.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.praycalc.app.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.praycalc.app.plist
    rm ~/Library/LaunchAgents/com.praycalc.app.plist

  Check status:
    launchctl list | grep praycalc

  View logs:
    cat /tmp/praycalc.stdout.log
    cat /tmp/praycalc.stderr.log

  Notes:
    - The ProgramArguments path assumes PrayCalc.app is installed in /Applications.
    - KeepAlive ensures automatic restart on crash. Set to false to disable.
    - ThrottleInterval prevents rapid restart loops (10 second cooldown).
    - RunAtLoad launches PrayCalc when the plist is first loaded and on login.
-->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.praycalc.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/PrayCalc.app/Contents/MacOS/PrayCalc</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/praycalc.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/praycalc.stderr.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
