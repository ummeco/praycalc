{
  "name": "praycalc-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev --port 3040",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --port 3040",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "axe": "axe http://localhost:4321 --exit",
    "lighthouse": "lhci autorun",
    "env:refresh": "bash ~/Sites/ummeco/scripts/env-refresh.sh"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/vercel": "^8.1.4",
    "@ummat/astro-preset": "file:./vendor/astro-preset",
    "@ummat/consent": "file:./vendor/consent",
    "@umalqura/core": "^0.0.7",
    "astro": "^5.7.13",
    "clsx": "^2.1.1",
    "luxon": "^3.5.0",
    "moon-cycle": "^2.0.0",
    "pray-calc": "^2.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.59.1",
    "@sentry/astro": "^10.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.27.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "6.4.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
