{
  "name": "praycalc-web",
  "version": "1.2.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3040",
    "build": "next build",
    "analyze": "ANALYZE=true pnpm build",
    "start": "next start --port 3040",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node_modules/.bin/playwright test",
    "test:e2e:ui": "node_modules/.bin/playwright test --ui",
    "test:e2e:report": "node_modules/.bin/playwright show-report",
    "setup": "pnpx tsx ~/Sites/ummeco/scripts/setup.sh",
    "doctor": "pnpx tsx ~/Sites/ummeco/scripts/doctor.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "env:refresh": "bash ~/Sites/ummeco/scripts/env-refresh.sh",
    "console:hasura": "open http://localhost:5543",
    "console:mail": "open http://localhost:5043",
    "console:storage": "open http://localhost:5443"
  },
  "dependencies": {
    "@ummat/consent": "file:./vendor/consent",
    "@assistant/conversation": "^3.8.1",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-model": "^1.86.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@sentry/nextjs": "^10.40.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.4.7",
    "ioredis": "^5.3.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "luxon": "^3.5.0",
    "luxon-hijri": "^2.1.0",
    "moon-cycle": "^2.0.0",
    "next": "16.2.5",
    "next-intl": "^4.9.1",
    "pray-calc": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.58.2",
    "@serwist/next": "^9.5.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.3.2",
      "fast-uri": ">=3.1.2",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.14",
      "vite": ">=7.3.2"
    }
  }
}