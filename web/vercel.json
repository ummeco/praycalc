{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "astro",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then exit 0; else exit 1; fi",
  "redirects": [
    {
      "source": "/times/:city+",
      "destination": "/:city+",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy",
      "statusCode": 301
    },
    {
      "source": "/terms",
      "destination": "/legal/terms",
      "statusCode": 301
    },
    {
      "source": "/cookies",
      "destination": "/legal/privacy",
      "statusCode": 301
    },
    {
      "source": "/tv/guest/:code",
      "destination": "/",
      "statusCode": 302
    },
    {
      "source": "/tv/setup",
      "destination": "/",
      "statusCode": 302
    },
    {
      "source": "/dashboard",
      "destination": "/",
      "statusCode": 302
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/",
      "statusCode": 302
    },
    {
      "source": "/activate",
      "destination": "/",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://cloud.umami.is https://errors.ummat.dev https://auth.ummat.dev; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/embed",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://auth.ummat.dev; frame-ancestors *; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/logo-sunrise.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
