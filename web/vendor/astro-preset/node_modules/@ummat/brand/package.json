{
  "name": "@ummat/brand",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for Ummat ecosystem design tokens, logos, Tailwind preset, and seasonal themes (T-P7-C-S10-01)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.cjs"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.cjs"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs",
      "require": "./dist/themes/index.cjs"
    },
    "./seasonal": {
      "types": "./dist/seasonal.d.ts",
      "import": "./dist/seasonal.mjs",
      "require": "./dist/seasonal.cjs"
    },
    "./apps/praycalc": {
      "types": "./dist/apps/praycalc.d.ts",
      "import": "./dist/apps/praycalc.mjs",
      "require": "./dist/apps/praycalc.cjs"
    },
    "./apps/islamwiki": {
      "types": "./dist/apps/islamwiki.d.ts",
      "import": "./dist/apps/islamwiki.mjs",
      "require": "./dist/apps/islamwiki.cjs"
    },
    "./apps/chatislam": {
      "types": "./dist/apps/chatislam.d.ts",
      "import": "./dist/apps/chatislam.mjs",
      "require": "./dist/apps/chatislam.cjs"
    },
    "./apps/flock": {
      "types": "./dist/apps/flock.d.ts",
      "import": "./dist/apps/flock.mjs",
      "require": "./dist/apps/flock.cjs"
    },
    "./apps/ummatApp": {
      "types": "./dist/apps/ummatApp.d.ts",
      "import": "./dist/apps/ummatApp.mjs",
      "require": "./dist/apps/ummatApp.cjs"
    },
    "./apps/ummatPro": {
      "types": "./dist/apps/ummatPro.d.ts",
      "import": "./dist/apps/ummatPro.mjs",
      "require": "./dist/apps/ummatPro.cjs"
    },
    "./apps/ummatChat": {
      "types": "./dist/apps/ummatChat.d.ts",
      "import": "./dist/apps/ummatChat.mjs",
      "require": "./dist/apps/ummatChat.cjs"
    },
    "./assets/*": "./assets/*",
    "./css": "./src/tokens.css",
    "./tokens/praycalc": "./src/themes/praycalc.css",
    "./tokens/islamwiki": "./src/themes/islamwiki.css",
    "./tokens/chatislam": "./src/themes/chatislam.css",
    "./tokens/ummat-app": "./src/themes/ummat-app.css",
    "./tokens/ummat-pro": "./src/themes/ummat-pro.css",
    "./tokens/ummat-dev": "./src/themes/ummat-dev.css",
    "./tokens/ummat-chat": "./src/themes/ummat-chat.css",
    "./tokens/flock": "./src/themes/flock.css",
    "./themes/dark-mode": "./src/themes/dark-mode.css",
    "./eslint-rule-no-brand-light-on-light": "./src/eslint-rule-no-brand-light-on-light.js",
    "./eslint-rule-no-physical-css": "./src/eslint-rule-no-physical-css.js"
  },
  "files": [
    "dist",
    "assets",
    "scripts",
    "src/tokens.css",
    "src/themes/*.css",
    "src/eslint-rule-no-brand-light-on-light.js",
    "src/eslint-rule-no-physical-css.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "brand:verify": "tsx scripts/verify-brand-assets.ts",
    "press:zip": "tsx scripts/build-press-kit-zip.ts",
    "brand:lint-rtl": "tsx scripts/lint-no-physical-css.ts",
    "brand:lint-rtl:ci": "tsx scripts/lint-no-physical-css.ts --error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:hex": "bash ./scripts/check-hardcoded-hex.sh"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "archiver": "^8.0.0",
    "eslint": "catalog:",
    "sharp": "^0.34.5",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
