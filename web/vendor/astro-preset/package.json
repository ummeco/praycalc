{
  "name": "@ummat/astro-preset",
  "version": "0.1.0",
  "private": true,
  "description": "Astro integration factory for Ummat sites. astroUmmat() injects @ummat/brand design tokens CSS, configures urql SSR, and sets the RTL document attribute for Arabic/Urdu/Farsi/Hebrew/Kurdish locales.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "@astrojs/react": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ummat/brand": "workspace:*",
    "astro": "^4.16.0",
    "tsup": "^8.0.0",
    "typescript": "catalog:",
    "vitest": "^3.2.6"
  }
}
