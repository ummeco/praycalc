---
/**
 * 500.astro — Server error page.
 *
 * PURPOSE: Branded fallback for uncaught SSR errors (output:'server' means
 *   every request runs server code that can throw — e.g. getUtcOffset() on
 *   bad tz data in [...slug].astro — and page routes have no per-route catch
 *   the way API routes do). Astro serves this file automatically for
 *   unhandled 500s under the @astrojs/vercel adapter. Mirrors 404.astro.
 * REF: WEB-11 (web audit gap-closure)
 */

import RootLayout from '@/layouts/RootLayout.astro';

Astro.response.status = 500;
---

<RootLayout
  title="Something Went Wrong | PrayCalc"
  description="An unexpected error occurred. Please try again."
  noIndex={true}
>
  <main id="main-content" class="min-h-screen flex flex-col items-center justify-center px-4 text-center">
    <h1 class="text-6xl font-bold text-white/20 mb-4">500</h1>
    <h2 class="text-2xl font-semibold text-white mb-3">Something went wrong</h2>
    <p class="text-white/50 mb-6">
      We hit an unexpected error. Please try again in a moment.
    </p>
    <a
      href="/"
      class="px-5 py-2.5 rounded-xl bg-ummat-mid/20 border border-ummat-mid/30 text-ummat-light text-sm font-medium hover:bg-ummat-mid/30 transition-colors"
    >
      Back to home
    </a>
  </main>
</RootLayout>
