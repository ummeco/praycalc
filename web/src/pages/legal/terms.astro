---
/**
 * legal/terms.astro — Terms of service page (static).
 * REF: P2-E3-W02-S02-T03
 */

import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout
  title="Terms of Service | PrayCalc"
  description="PrayCalc terms of service."
  canonical="https://praycalc.com/legal/terms"
>
  <main id="main-content" class="info-page">
    <div class="info-page-inner">
      <div class="info-page-header">
        <a href="/" class="info-page-back">← Home</a>
      </div>
      <h1 class="text-3xl font-bold text-white">Terms of Service</h1>
      <p class="text-white/40 text-sm">Last updated: June 2026</p>

      <section class="info-section">
        <p class="text-white/60 leading-relaxed">
          PrayCalc is provided free of charge as a utility for the Muslim community.
          Prayer times are calculated using astronomical algorithms and are provided for
          informational purposes. PrayCalc does not provide religious rulings.
          Always consult a qualified scholar for fiqh matters.
        </p>
      </section>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">Disclaimer</h2>
        <p class="text-white/60 leading-relaxed">
          Prayer times shown are calculated approximations. Actual times may vary
          by location, elevation, and local custom. Always verify with your local
          mosque or Islamic authority for prayer times used in congregational prayer.
        </p>
      </section>
    </div>
  </main>
</RootLayout>
