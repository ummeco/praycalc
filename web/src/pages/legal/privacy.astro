---
/**
 * legal/privacy.astro — Privacy policy page (static).
 * REF: P2-E3-W02-S02-T03
 */

import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout
  title="Privacy Policy | PrayCalc"
  description="PrayCalc privacy policy — what data we collect and how we use it."
  canonical="https://praycalc.com/legal/privacy"
>
  <main id="main-content" class="info-page">
    <div class="info-page-inner">
      <div class="info-page-header">
        <a href="/" class="info-page-back">← Home</a>
      </div>
      <h1 class="text-3xl font-bold text-white">Privacy Policy</h1>
      <p class="text-white/40 text-sm">Last updated: June 2026</p>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">What we collect</h2>
        <p class="text-white/60 leading-relaxed">
          PrayCalc does not collect personal data. Location coordinates entered for
          prayer time calculation are processed client-side and are never sent to our
          servers. Umami analytics collects anonymous page view counts only — no cookies,
          no IP addresses, no fingerprinting.
        </p>
      </section>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">Local storage</h2>
        <p class="text-white/60 leading-relaxed">
          PrayCalc stores your settings (madhab preference, time format, last visited cities)
          in your browser's localStorage. This data never leaves your device.
        </p>
      </section>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">Contact</h2>
        <p class="text-white/60">
          Questions? <a href="/contact" class="text-ummat-light/60 hover:text-ummat-light">Contact us</a>.
        </p>
      </section>
    </div>
  </main>
</RootLayout>
