---
/**
 * legal/california.astro — CCPA/CPRA disclosure page (praycalc.com).
 *
 * PURPOSE: California Consumer Privacy Act rights disclosure. Precise
 *   geolocation (used for prayer times / Qibla direction) is classified as
 *   sensitive personal information under CPRA § 1798.121.
 * CONSTRAINTS: noIndex — DO NOT flip to indexed or remove the DRAFT banner
 *   until the remaining U-15 publication checklist items (privacy-policy
 *   cross-check, footer link, ticket closure) are resolved (TRAP-P6
 *   do-not-publish rule). The 4 TODO(U-15) copy blocks were filled with
 *   standard CCPA boilerplate per owner direction 2026-07-12 (attorney
 *   review waived by owner; still welcome) — source draft at
 *   .github/docs/legal/california-ccpa-draft.md, placeholder tracker at
 *   .github/docs/CREDENTIALS.md. Ported as-is from the pre-Astro-migration
 *   Next.js page (git a4993c5). See .github/docs/adr/ADR-consent-banner-astro-gate.md.
 * REF: S05-11 · U-15
 */
import RootLayout from '@/layouts/RootLayout.astro';

const categories: Array<[string, string, string]> = [
  ['Identifiers', 'Email (account), IP address', 'Yes'],
  [
    'Precise geolocation (sensitive)',
    'GPS coordinates used for prayer time calculation (browser API, with permission)',
    'Yes — session only; not stored',
  ],
  ['Coarse geolocation', 'Country/region via IP (always used as fallback)', 'Yes'],
  ['Internet activity', 'Pages viewed (aggregated analytics)', 'Yes — aggregated'],
  ['Commercial information', 'Subscription status (Ummat+ members only)', 'Yes — members only'],
  ['Inferences', 'No user profiles drawn from location data', 'No'],
];
---

<RootLayout
  title="California Privacy Rights | PrayCalc"
  description="California Consumer Privacy Act (CCPA/CPRA) disclosure for PrayCalc. Location data rights and opt-out."
  noIndex={true}
>
  <main id="main-content" class="info-page">
    <div class="info-page-inner">
      <!-- Draft — do not publish until U-15 resolved -->
      <div class="rounded-lg border border-yellow-500/40 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-300">
        <strong>DRAFT — Not yet effective.</strong> Standard CCPA boilerplate applied per owner
        direction (U-15); attorney review still welcome. Committed for development review only.
        Do not link from production footers until the full U-15 checklist is resolved.
      </div>

      <div class="info-page-header">
        <a href="/legal/privacy" class="info-page-back">← Back to Privacy Policy</a>
      </div>

      <div class="info-section">
        <h1 class="text-3xl font-bold text-white sm:text-4xl">California Privacy Rights</h1>
        <p class="text-white/40 text-sm">
          California Consumer Privacy Rights Act (CPRA/CCPA) — Last updated: May 6, 2026
        </p>
        <p class="text-white/70 max-w-2xl text-sm leading-relaxed">
          PrayCalc uses your location to calculate accurate prayer times and Qibla direction.
          Under the California Consumer Privacy Rights Act (CPRA, as amended by Prop 24),
          <strong class="text-white/90">precise geolocation is classified as sensitive personal information</strong>.
          You have the right to limit our use of this data.
          <!-- standard CCPA boilerplate applied per owner direction 2026-07-12; attorney review welcome -->
        </p>
        <p class="text-white/70 max-w-2xl text-sm leading-relaxed">
          This page describes your rights with respect to <strong class="text-white/90">Ummeco LLC</strong>,
          a Delaware limited liability company doing business as PrayCalc ("we," "us," or "our").
          Our principal place of business is 1679 S. Dupont Hwy, Suite 100, Dover, DE 19901.
          For privacy inquiries, email
          <a href="mailto:privacy@ummat.dev" class="text-ummat-light/80 hover:text-ummat-light underline">privacy@ummat.dev</a>.
        </p>
      </div>

      <!-- Do Not Sell — prominent -->
      <div class="rounded-xl border border-ummat-dark/40 bg-ummat-dark/10 px-6 py-6">
        <h2 class="text-base font-semibold text-white mb-2">Do Not Sell or Share My Personal Information</h2>
        <p class="text-sm text-white/60 mb-4">
          <!-- standard CCPA boilerplate applied per owner direction 2026-07-12; attorney review welcome -->
          Ummeco LLC does not sell personal information, including location data, to third parties. We
          do not share personal information with third parties for cross-context behavioral advertising.
          Our analytics (Umami) is limited to anonymized, aggregated usage statistics and does not
          disclose personal information to a third party for monetary consideration or for advertising
          purposes, so it does not constitute a "sale" or "sharing" under CPRA § 1798.140(ad).
        </p>
        <a
          href="mailto:privacy@ummat.dev?subject=CPRA%20Opt-Out%20Request&body=Full%20name%3A%0AEmail%3A%0ARequest%3A%20Do%20not%20sell%20or%20share%20my%20personal%20information."
          class="inline-flex items-center gap-2 rounded-lg bg-ummat-mid px-5 py-2.5 text-sm font-medium text-ummat-deep hover:bg-ummat-light transition-colors"
        >
          Submit Opt-Out Request — privacy@ummat.dev
        </a>
      </div>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">Categories of Personal Information We Collect</h2>
        <p class="text-white/50 text-xs mb-2">
          <!-- standard CCPA boilerplate applied per owner direction 2026-07-12; attorney review welcome -->
          Precise geolocation (GPS coordinates) is treated as sensitive personal information under CPRA
          § 1798.140(ae). IP-derived coarse location is listed separately from IP address as an
          identifier because it serves a distinct fallback purpose in our systems.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-white/10">
                <th class="text-left py-2 pr-4 text-white/50 font-medium">Category</th>
                <th class="text-left py-2 pr-4 text-white/50 font-medium">Examples</th>
                <th class="text-left py-2 text-white/50 font-medium">Collected?</th>
              </tr>
            </thead>
            <tbody>
              {categories.map(([cat, ex, col]) => (
                <tr class="border-b border-white/5">
                  <td class="py-2 pr-4 text-white/80">{cat}</td>
                  <td class="py-2 pr-4 text-white/40">{ex}</td>
                  <td class:list={['py-2 font-medium text-xs', col === 'No' ? 'text-white/30' : 'text-ummat-light']}>{col}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">Sensitive Personal Information — Location Data</h2>
        <p class="text-white/70 text-sm leading-relaxed">
          <!-- standard CCPA boilerplate applied per owner direction 2026-07-12; attorney review welcome -->
          Under CPRA § 1798.121, you have the right to direct us to limit the use and disclosure of your
          sensitive personal information (including precise geolocation) to uses that are reasonably
          necessary and proportionate to provide the prayer time calculation service you have requested.
        </p>
        <p class="text-white/70 text-sm leading-relaxed">
          PrayCalc uses your precise location exclusively to calculate prayer times and Qibla direction
          for your current or saved location. We do not use precise location for targeted advertising or
          profiling, sale or sharing with third parties, or inferences about your interests, behavior, or
          characteristics beyond prayer-time calculation. Because we do not use precise geolocation for
          any purpose beyond service delivery, exercising your right to limit does not meaningfully
          restrict any additional use. If this changes, we will update this page and provide a prominent
          "Limit the Use of My Sensitive Personal Information" link as required by § 1798.135.
        </p>
        <p class="text-white/70 text-sm leading-relaxed">
          PrayCalc accesses precise location only within your browser session (using the Geolocation API), and
          only with your explicit browser permission. Precise coordinates are not persisted to our servers.
          You can revoke location permission at any time in your browser settings.
        </p>
        <p class="text-white/70 text-sm leading-relaxed">
          To limit use of your location data beyond prayer time calculation, email
          <a href="mailto:privacy@ummat.dev" class="text-ummat-light/80 hover:text-ummat-light underline">privacy@ummat.dev</a>.
        </p>
      </section>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">Your California Rights</h2>
        <div class="text-white/70 text-sm leading-relaxed space-y-3">
          <div>
            <h3 class="text-base font-semibold text-white">Right to Know</h3>
            <p>You may request disclosure of the categories and specific pieces of personal information we have collected about you.</p>
          </div>
          <div>
            <h3 class="text-base font-semibold text-white">Right to Delete</h3>
            <p>You may request deletion of your account and associated personal information.</p>
          </div>
          <div>
            <h3 class="text-base font-semibold text-white">Right to Correct</h3>
            <p>You may request correction of inaccurate personal information. Account details can be updated in settings.</p>
          </div>
          <div>
            <h3 class="text-base font-semibold text-white">Right to Opt-Out of Sale or Sharing</h3>
            <p>We do not sell personal information, including location data.</p>
          </div>
          <div>
            <h3 class="text-base font-semibold text-white">Right to Limit Use of Sensitive Personal Information</h3>
            <p>You have the right to limit use of your precise geolocation to providing the prayer time service. No additional uses apply.</p>
          </div>
          <div>
            <h3 class="text-base font-semibold text-white">Right to Non-Discrimination</h3>
            <p>We will not discriminate against you for exercising your CPRA rights.</p>
          </div>
        </div>
      </section>

      <section class="info-section">
        <h2 class="text-xl font-semibold text-ummat-light">How to Submit a Request</h2>
        <p class="text-white/70 text-sm leading-relaxed">
          Email <a href="mailto:privacy@ummat.dev" class="text-ummat-light/80 hover:text-ummat-light underline">privacy@ummat.dev</a> with subject "CPRA Request". Include your full name and account email.
        </p>
        <p class="text-white/70 text-sm leading-relaxed">We respond within 45 days (extendable to 90 days with notice).</p>
      </section>

      <section class="info-section border-t border-white/10 pt-6">
        <h2 class="text-lg font-semibold text-white">Related</h2>
        <ul class="space-y-1 text-sm">
          <li><a href="/legal/privacy" class="text-ummat-light/80 hover:text-ummat-light underline">Privacy Policy</a></li>
          <li><a href="/preferences" class="text-ummat-light/80 hover:text-ummat-light underline">Manage Cookie Preferences</a></li>
        </ul>
      </section>
    </div>
  </main>
</RootLayout>
