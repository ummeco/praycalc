---
/**
 * contact.astro — Contact page (static).
 * REF: P2-E3-W02-S02-T03
 */

import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout
  title="Contact | PrayCalc"
  description="Contact PrayCalc."
  canonical="https://praycalc.com/contact"
>
  <main id="main-content" class="info-page">
    <div class="info-page-inner">
      <div class="info-page-header">
        <a href="/" class="info-page-back">← Home</a>
      </div>
      <h1 class="text-3xl font-bold text-white">Contact</h1>
      <section class="info-section">
        <p class="text-white/60 leading-relaxed">
          For feedback, bug reports, or questions, please visit
          <a
            href="https://praycalc.org"
            class="text-ummat-light/70 hover:text-ummat-light"
            target="_blank"
            rel="noopener"
          >praycalc.org</a>.
        </p>
      </section>
    </div>
  </main>
</RootLayout>
