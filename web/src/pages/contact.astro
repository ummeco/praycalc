---
/**
 * contact.astro — Contact page (static).
 * REF: P2-E3-W02-S02-T03
 */

import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout
  title="Contact | PrayCalc"
  description="Get in touch with the PrayCalc team — support, feedback, corrections, and partnership enquiries."
  canonical="https://praycalc.com/contact"
>
  <main id="main-content" class="info-page">
    <div class="info-page-inner">
      <div class="info-page-header">
        <a href="/" class="info-page-back">← Home</a>
      </div>
      <h1 class="text-3xl font-bold text-white">Contact</h1>
      <section class="info-section">
        <p class="text-white/60 leading-relaxed">
          We'd love to hear from you — feedback, bug reports, prayer-time
          corrections, or partnership enquiries. Pick whichever suits you:
        </p>
        <div class="flex flex-col gap-3 mt-2">
          <a
            href="mailto:salam@praycalc.com"
            class="rounded-xl border border-white/10 bg-white/[0.03] p-4 hover:border-ummat-light/30 transition-colors"
          >
            <div class="text-white/90 font-semibold">Email us</div>
            <div class="text-ummat-light/80 text-sm">salam@praycalc.com</div>
            <div class="text-white/50 text-sm mt-1">General questions, feedback, and support.</div>
          </a>
          <a
            href="https://github.com/ummeco/praycalc/issues/new"
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-white/10 bg-white/[0.03] p-4 hover:border-ummat-light/30 transition-colors"
          >
            <div class="text-white/90 font-semibold">Report a bug or request a feature</div>
            <div class="text-ummat-light/80 text-sm">github.com/ummeco/praycalc</div>
            <div class="text-white/50 text-sm mt-1">Open an issue — the fastest path for technical reports.</div>
          </a>
          <a
            href="https://praycalc.org"
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-white/10 bg-white/[0.03] p-4 hover:border-ummat-light/30 transition-colors"
          >
            <div class="text-white/90 font-semibold">Documentation</div>
            <div class="text-ummat-light/80 text-sm">praycalc.org</div>
            <div class="text-white/50 text-sm mt-1">Calculation methods, the science, and how-to guides.</div>
          </a>
        </div>
        <p class="text-white/40 text-sm mt-2">
          Prayer-time accuracy is our priority — if a time looks off for your
          location, email us the city and method and we'll look into it.
        </p>
      </section>
    </div>
  </main>
</RootLayout>
