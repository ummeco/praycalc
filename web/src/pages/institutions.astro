---
/**
 * institutions.astro — Islamic Calendar & Accommodation Guide for Institutions.
 *
 * PURPOSE: Static reference page for schools, universities, correctional
 *   facilities, hospitals, the U.S. military, employers, and government
 *   agencies on Islamic religious obligations and reasonable accommodation.
 *   Includes a multi-year table of key Islamic dates computed at build time.
 * THEOLOGY GATE: Content describes obligations under ahl us-sunnah wal-jama'ah
 *   consensus (five daily prayers, Ramadan fast, two Eids, Hajj). Dates use the
 *   Umm al-Qura calendar (lib/islamic-dates.ts); a ±1 day moon-sighting caveat
 *   is shown. No new fiqh methodology claims.
 * CONSTRAINTS: Page owns only the build-time date computation; all markup
 *   lives in src/components/institutions/* (2026-07 file-size split, kept the
 *   page under the 300-line cap). Content/behavior unchanged from the
 *   pre-split single-file version.
 * REF: restored from git ecc0a7c^ (Next.js era) · D-P2-STACK-CANON (Astro)
 */
import RootLayout from '@/layouts/RootLayout.astro';
import { getMultiYearDates, getCurrentHijriYear } from '@/lib/islamic-dates';
import IntroSection from '@/components/institutions/IntroSection.astro';
import DatesTable from '@/components/institutions/DatesTable.astro';
import DateMeanings from '@/components/institutions/DateMeanings.astro';
import AccommodationGuidelines from '@/components/institutions/AccommodationGuidelines.astro';
import ResourcesAndCta from '@/components/institutions/ResourcesAndCta.astro';

// Forward-looking table: current Hijri year + 15 years ahead (~16-year horizon).
// Starting at the current year means no stale past rows and zero annual upkeep —
// the "current" highlight is always the first row and advances each Hijri new year.
const START_YEAR = getCurrentHijriYear();
const YEAR_COUNT = 16;
const yearData = getMultiYearDates(START_YEAR, YEAR_COUNT);
const currentHijriYear = START_YEAR;
---

<RootLayout
  title="Islamic Calendar for Institutions | PrayCalc"
  description="Multi-year Islamic dates and religious-accommodation guidance for schools, prisons, hospitals, the military, and employers. Ramadan, Eid al-Fitr, Eid al-Adha, and daily prayer, dietary, and dress accommodations."
  canonical="https://praycalc.com/institutions"
>
  <main id="main-content" class="info-page">
    <div class="info-page-inner">
      <!-- Header -->
      <div class="info-page-header">
        <a href="/" class="info-page-back">← PrayCalc</a>
      </div>
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <h1 class="text-3xl font-bold text-white">Islamic Calendar for Institutions</h1>
        <button
          type="button"
          id="print-page"
          class="shrink-0 text-sm text-ummat-light/70 hover:text-ummat-light border border-ummat-light/30 rounded-lg px-3 py-1.5 transition-colors print:hidden"
        >
          Print this page
        </button>
      </div>
      <div class="h-px bg-white/10"></div>

      <IntroSection />
      <DatesTable yearData={yearData} currentHijriYear={currentHijriYear} />
      <DateMeanings />
      <AccommodationGuidelines />
      <ResourcesAndCta />
    </div>
  </main>

  <script>
    document.getElementById('print-page')?.addEventListener('click', () => window.print());
  </script>
</RootLayout>
