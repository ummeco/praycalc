---
/**
 * index.astro — PrayCalc home page.
 *
 * PURPOSE: Home shell — logo, location search island, moon-phase card, and a
 *   delayed geolocation prompt island. No prayer times here; the user picks a city.
 * CONSTRAINTS: No Next.js patterns. Island pattern for interactive parts.
 * REF: P2-PRAYCALC-E2E-REBUILD · homepage.spec.ts
 */

import RootLayout from '@/layouts/RootLayout.astro';
import LocationSearch from '@/islands/LocationSearch';
import GeoPrompt from '@/islands/home/GeoPrompt';
import { getMoonPhase } from '@/lib/moon';

const moon = getMoonPhase();

// Localized tagline (NEXT_LOCALE cookie via middleware). Arabic/Urdu render in
// their own script so RTL locales have visible localized copy.
const locale = Astro.locals?.locale ?? 'en';
const TAGLINES: Record<string, string> = {
  en: 'Prayer times for any city, airport, or zip code',
  ar: 'مواقيت الصلاة لأي مدينة أو مطار أو رمز بريدي',
  ur: 'کسی بھی شہر، ہوائی اڈے یا زپ کوڈ کے لیے نماز کے اوقات',
};
const tagline = TAGLINES[locale] ?? TAGLINES.en;
---

<RootLayout
  title="PrayCalc — Islamic Prayer Times"
  description="Accurate Islamic prayer times for any location. GPS-based, multiple calculation methods, Qibla direction, moon phases, and Hijri calendar."
  canonical="https://praycalc.com"
>
  <main id="main-content" class="home-main relative">
    <h1 class="sr-only">PrayCalc — accurate Islamic prayer times for any location</h1>
    <a
      href="https://praycalc.org"
      target="_blank"
      rel="noopener noreferrer"
      class="about-pill"
    >
      About PrayCalc
    </a>

    <!-- Logo -->
    <div class="logo-sunrise-outer">
      <div class="logo-sunrise-glow" aria-hidden="true"></div>
      <div class="logo-sunrise">
        <img
          src="/logo-sunrise.svg"
          alt="PrayCalc"
          width="160"
          height="160"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <!-- Location search island -->
    <div class="w-full max-w-[480px] mt-[-25px] px-4">
      <LocationSearch client:load autoFocus={true} />
      <p class="home-tagline text-white/25 text-xs text-center mt-2">
        {tagline}
      </p>
    </div>

    <!-- Moon phase card -->
    <div class="home-moon-card" aria-label="Current moon phase">
      <span class="home-moon-emoji" aria-hidden="true">{moon.emoji}</span>
      <div class="home-moon-info">
        <span class="home-moon-name">{moon.phaseName}</span>
        <span class="home-moon-illum">{moon.illumination}% illuminated</span>
      </div>
    </div>

    <div class="flex-1"></div>

    <!-- Delayed geolocation prompt island -->
    <GeoPrompt client:load />
  </main>
</RootLayout>
