---
/**
 * upgrade/success.astro — Ummat+ checkout success page.
 *
 * PURPOSE: Stripe Checkout success_url target (see
 *   praycalc/smart/src/routes/billing.ts: success_url =
 *   'https://praycalc.com/upgrade/success?session_id={CHECKOUT_SESSION_ID}').
 *   Reads session_id from the URL and shows a thank-you confirmation.
 * CONSTRAINTS: Static Astro page (no client island needed) — the actual
 *   entitlement is set server-side via the Stripe webhook; this page is a
 *   confirmation only, not the source of truth for plan state.
 * REF: praycalc/smart/src/routes/billing.ts · real-auth task (2026-07)
 */

import RootLayout from '@/layouts/RootLayout.astro';

const sessionId = Astro.url.searchParams.get('session_id');
---

<RootLayout
  title="Welcome to Ummat+ | PrayCalc"
  description="Your Ummat+ upgrade is complete."
  canonical="https://praycalc.com/upgrade/success"
  noIndex={true}
>
  <main id="main-content" class="info-page">
    <div class="info-page-inner">
      <div class="info-page-header">
        <a href="/account" class="info-page-back">← Account</a>
      </div>
      <h1 class="text-3xl font-bold text-white">You're all set!</h1>
      <section class="info-section">
        <p class="text-white/60 leading-relaxed">
          Thank you for upgrading to Ummat+. Your account will reflect the new plan shortly.
        </p>
        {sessionId && (
          <p class="text-white/40 text-sm leading-relaxed" data-testid="checkout-session-id">
            Confirmation: {sessionId}
          </p>
        )}
        <a
          href="/account"
          class="text-ummat-light/70 hover:text-ummat-light"
        >Go to your account →</a>
      </section>
    </div>
  </main>
</RootLayout>
