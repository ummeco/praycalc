---
/**
 * 404.astro — Not found page.
 * REF: P2-E3-W02-S02-T03
 */

import RootLayout from '@/layouts/RootLayout.astro';

Astro.response.status = 404;
---

<RootLayout
  title="Page Not Found | PrayCalc"
  description="The page you were looking for could not be found."
  noIndex={true}
>
  <main id="main-content" class="min-h-screen flex flex-col items-center justify-center px-4 text-center">
    <h1 class="text-6xl font-bold text-white/20 mb-4">404</h1>
    <h2 class="text-2xl font-semibold text-white mb-3">Page not found</h2>
    <p class="text-white/50 mb-6">
      The page you were looking for doesn't exist.
    </p>
    <a
      href="/"
      class="px-5 py-2.5 rounded-xl bg-ummat-mid/20 border border-ummat-mid/30 text-ummat-light text-sm font-medium hover:bg-ummat-mid/30 transition-colors"
    >
      Back to home
    </a>
  </main>
</RootLayout>
