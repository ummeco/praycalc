---
/**
 * Footer.astro — shared site footer.
 *
 * PURPOSE: One consistent footer across every page (was hand-rolled + drifting
 *   per-page, or absent on 8+ pages). Rendered by RootLayout unless hideFooter.
 * A11y: nav landmark; link contrast raised to meet WCAG AA (was text-white/25).
 */
const YEAR = 2026;
const links = [
  { href: '/', label: 'Home' },
  { href: '/times', label: 'All Cities' },
  { href: '/institutions', label: 'Institutions' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/legal/privacy', label: 'Privacy' },
  { href: '/legal/terms', label: 'Terms' },
  { href: '/preferences', label: 'Cookie Settings' },
];
---

<footer class="w-full max-w-2xl mx-auto px-4 py-8 mt-8">
  <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-white/55 text-xs" aria-label="Footer">
    {links.map((l) => (
      <a href={l.href} class="hover:text-white transition-colors">{l.label}</a>
    ))}
    <a
      href="https://praycalc.org"
      class="hover:text-ummat-light text-ummat-light/70 transition-colors"
      target="_blank"
      rel="noopener"
    >praycalc.org</a>
  </nav>
  <p class="text-center text-white/40 text-xs mt-3">
    Free, accurate Islamic prayer times. No ads. Privacy-friendly analytics only.
  </p>
  <p class="text-center text-white/30 text-[0.7rem] mt-1">© {YEAR} PrayCalc · part of the Ummat ecosystem</p>
</footer>
