# PrayCalc — local environment variables
# Copy this file to .env.local and fill in values.
# .env.local is gitignored and never committed.
# IMPORTANT: Always use local nSelf credentials here. NEVER paste production secrets.
# Production credentials live in the nSelf vault and are injected by Vercel/nSelf at deploy time.

# Hasura GraphQL endpoint (local dev via nSelf — note port 8543)
NEXT_PUBLIC_HASURA_URL=https://api.praycalc.local.nself.org:8543/v1/graphql

# Auth endpoint (local dev via nSelf)
NEXT_PUBLIC_AUTH_URL=https://auth.local.nself.org:8543

# Admin GraphQL endpoint — server-side only, never exposed to browser
# Local: use nSelf admin URL; production value lives in Vercel env vars, not here
HASURA_ADMIN_URL=https://api.dev.ummat.local.nself.org:8543/v1/graphql

# Hasura admin secret — get from ummat/backend/.env.local (local nSelf value only)
# NEVER use the production admin secret here
HASURA_GRAPHQL_ADMIN_SECRET=

# Hasura JWT signing key — get from ummat/backend/.env.local (local nSelf value only)
# NEVER use the production JWT key here
HASURA_JWT_KEY=

# Remote Schema secret (Hasura sends this when calling /api/graphql)
# Must match REMOTE_SCHEMA_SECRET in ummat/backend/.env.local
REMOTE_SCHEMA_SECRET=

# Stripe publishable key (safe to use test key locally)
# Use test key: pk_test_... — never use pk_live_... in local dev
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Turbo remote cache (optional for local dev)
TURBO_CACHE=
TURBO_DOWNLOAD_LOCAL_ENABLED=
TURBO_REMOTE_ONLY=
TURBO_RUN_SUMMARY=

# Sentry error monitoring DSN (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
