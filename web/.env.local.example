# PrayCalc — local environment variables
# Copy this file to .env.local and fill in values.
# .env.local is gitignored and never committed.
# IMPORTANT: Always use local nSelf credentials here. NEVER paste production secrets.
# Production credentials live in the nSelf vault and are injected by Vercel/nSelf at deploy time.

# Hasura GraphQL endpoint (local dev via nSelf — note port 8543)
NEXT_PUBLIC_HASURA_URL=https://api.praycalc.local.nself.org:8543/v1/graphql

# Auth endpoint (local dev via nSelf)
NEXT_PUBLIC_AUTH_URL=https://auth.local.nself.org:8543

# Admin GraphQL endpoint — server-side only, never exposed to browser
# Local: use nSelf admin URL; production value lives in Vercel env vars, not here
HASURA_ADMIN_URL=https://api.dev.ummat.local.nself.org:8543/v1/graphql

# Hasura admin secret — get from ummat/backend/.env.local (local nSelf value only)
# NEVER use the production admin secret here
HASURA_GRAPHQL_ADMIN_SECRET=

# Hasura JWT signing key — get from ummat/backend/.env.local (local nSelf value only)
# NEVER use the production JWT key here
HASURA_JWT_KEY=

# Remote Schema secret (Hasura sends this when calling /api/graphql)
# Must match REMOTE_SCHEMA_SECRET in ummat/backend/.env.local
REMOTE_SCHEMA_SECRET=

# Stripe publishable key (safe to use test key locally)
# Use test key: pk_test_... — never use pk_live_... in local dev
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Turbo remote cache (optional for local dev)
TURBO_CACHE=
TURBO_DOWNLOAD_LOCAL_ENABLED=
TURBO_REMOTE_ONLY=
TURBO_RUN_SUMMARY=

# Sentry error monitoring DSN (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile — bot protection for /account/delete form (D-P3-20)
# Site key (public — safe to expose to browser)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# Secret key (server-side only — never expose to browser)
CLOUDFLARE_TURNSTILE_SECRET=

# S6-18 — In-App Purchase (IAP) — Apple StoreKit 2 + Google Play Billing v6
# true = sandbox mode (no real charges). Default for P3.
# Set false only when submitting to production App Store / Play Store review.
APPLE_IAP_SANDBOX=true
GOOGLE_IAP_SANDBOX=true

# Google Play Developer API — service account JSON (base64 encoded).
# Required for server-side purchase verification in production mode.
# base64 encode from: base64 -i service-account.json
# Source: Google Play Console > Setup > API access > Service accounts
# Vault key: GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Hasura action secret — used by IAP validate routes to authenticate Hasura callbacks.
# Must match HASURA_ACTION_SECRET in ummat/backend/.env.local
HASURA_ACTION_SECRET=

# IAP validate handler URLs (used in Hasura actions metadata).
# Automatically set to praycalc.com in production via Vercel env.
PRAYCALC_IAP_APPLE_HANDLER_URL=https://praycalc.com/api/iap/apple/validate
PRAYCALC_IAP_GOOGLE_HANDLER_URL=https://praycalc.com/api/iap/google/validate
