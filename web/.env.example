# praycalc/web — environment variables (Astro 5, D-P2-STACK-CANON)
# Copy to .env.local and fill in values. Run: pnpm dev (astro dev --port 3040)
#
# Astro convention: only PUBLIC_-prefixed vars are inlined into the client
# bundle. Everything else here is server-only (SSR / API routes) and never
# reaches the browser. This file lists exactly the vars actually read by src/
# — see WEB-06 (web audit gap-closure): the previous version was 100%
# Next.js-era (NEXT_PUBLIC_*, TURNSTILE_*, ALEXA_*, GOOGLE_ACTIONS_*, IAP/FF_*)
# and referenced nothing the Astro app actually reads.

# ─── Client-exposed (PUBLIC_ prefix) ─────────────────────────────────────────

# Hasura GraphQL endpoint (per-app CORS-restricted). Used by TV-linking calls
# (src/lib/tv/hasura.server.ts). Prod default: https://api.praycalc.com/v1/graphql
PUBLIC_HASURA_URL=

# Shared Ummat Hasura Auth endpoint (src/lib/auth/client.ts,
# src/lib/auth/hasura.server.ts). Prod default: https://auth.ummat.dev
PUBLIC_AUTH_URL=

# PrayCalc "smart" billing service (Ummat+ entitlement / Stripe checkout —
# src/pages/api/billing/*.ts, src/pages/api/tvs/index.ts). Prod default:
# https://smart.praycalc.com/billing
PUBLIC_BILLING_URL=

# Set to "disabled" to skip billing network calls entirely (src/lib/billing.ts)
# — the upgrade CTA shows a graceful "launching soon" state instead of erroring.
# Useful locally when the billing service isn't running.
PUBLIC_BILLING_MODE=

# Client-side Sentry DSN (src/lib/sentry-client-init.ts, lazy-loaded off the
# critical rendering path — see RootLayout.astro for why). Leave unset to
# disable client monitoring entirely.
PUBLIC_SENTRY_DSN_PRAYCALC=

# ─── Server-only ──────────────────────────────────────────────────────────────

# Server-side Sentry DSN (sentry.server.config.ts, auto-loaded by @sentry/astro).
SENTRY_DSN_PRAYCALC=

# Sentry source-map upload token (astro.config.ts build-time only — CI/Vercel).
SENTRY_AUTH_TOKEN=

# Admin GraphQL endpoint + secret — server-only, used ONLY by
# src/pages/api/consent.ts to write the GDPR Art. 7 consent audit trail.
# REQUIRED IN PROD: both must be set or consent decisions silently fail to
# persist (WEB-02) — the route degrades gracefully (200, recorded:false) but
# logs a server-side error when either is missing.
HASURA_ADMIN_URL=
HASURA_GRAPHQL_ADMIN_SECRET=

# Umami analytics website ID (src/layouts/RootLayout.astro — passed to the
# consent-gated ConsentGate island; D-P3-21, Umami only, no Vercel Analytics).
UMAMI_WEBSITE_ID=
