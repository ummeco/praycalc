# praycalc/web — environment variables
# Copy to .env.local and fill in values
# Run: next dev --port 3041

# Hasura GraphQL endpoint (per-app CORS-restricted)
NEXT_PUBLIC_HASURA_URL=https://api.praycalc.local.nself.org:8543/v1/graphql

# Hasura Auth endpoint (shared SSO across all apps)
NEXT_PUBLIC_AUTH_URL=https://auth.local.nself.org:8543

# Auth client URL scoped to THIS app — tells Hasura Auth where to redirect after email confirm.
# Prod: sourced from vault AUTH_CLIENT_URL_PRAYCALC.
AUTH_CLIENT_URL=https://praycalc.com

# Public base URL for this app
NEXT_PUBLIC_BASE_URL=https://www.praycalc.local.nself.org:8543

# Secret for validating Remote Schema requests from Hasura
REMOTE_SCHEMA_SECRET=

# Monitoring — Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ummeco
SENTRY_PROJECT=praycalc-web

# Monitoring — Umami analytics (D-P3-21)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── IAP — Apple StoreKit 2 (S6-18) ─────────────────────────────────────────
# Set to "true" for sandbox mode (default for P3 — no real charges).
# Set to "false" in production after Apple App Store review approval.
# See: praycalc/.claude/docs/IAP-SMOKE-TEST-SPEC.md
APPLE_IAP_SANDBOX=true

# ─── IAP — Google Play Billing v6 (S6-18) ────────────────────────────────────
# Base64-encoded service account JSON with the following IAM roles:
#   - roles/androidpublisher.viewer (for purchases.subscriptions.get)
# Generate in Google Cloud Console → IAM → Service Accounts.
# Encode: base64 -i service-account.json | tr -d '\n'
# Store full value in vault: GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
# See vault.env for the production value (PRAYCALC_GOOGLE_PLAY_SA_JSON).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=  # base64 JSON — from vault

# Set to "true" for sandbox mode (skips real Play Developer API call).
# Must be "false" in production builds after Play Store review.
GOOGLE_IAP_SANDBOX=true

# ─── IAP — Cloudflare Turnstile (account deletion gate, S6-04) ───────────────
# Site key (public, safe to expose via NEXT_PUBLIC_).
# Secret key is server-only; never expose to client.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=
