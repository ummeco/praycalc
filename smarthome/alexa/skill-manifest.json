{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "PrayCalc",
          "summary": "Accurate Islamic prayer times, Qibla direction, and adhan reminders.",
          "description": "PrayCalc delivers GPS-accurate prayer times for all 5 daily prayers, supports 10+ calculation methods (ISNA, MWL, Umm al-Qura, Egypt, Tehran, Karachi), and gives the Qibla direction from any location. Ask for prayer times, specific prayers, or tomorrow's schedule.",
          "examplePhrases": [
            "Alexa, open PrayCalc",
            "Alexa, ask PrayCalc when is Asr",
            "Alexa, ask PrayCalc for all prayer times"
          ],
          "keywords": ["prayer times", "Islamic", "Muslim", "Fajr", "Asr", "Qibla", "adhan", "salah"],
          "smallIconUri": "https://praycalc.com/assets/alexa-icon-108.png",
          "largeIconUri": "https://praycalc.com/assets/alexa-icon-512.png"
        },
        "en-GB": {
          "name": "PrayCalc",
          "summary": "Accurate Islamic prayer times and Qibla direction.",
          "description": "PrayCalc delivers GPS-accurate prayer times for all 5 daily prayers. Ask for prayer times, Qibla direction, or tomorrow's schedule.",
          "examplePhrases": [
            "Alexa, open PrayCalc",
            "Alexa, ask PrayCalc when is Maghrib"
          ],
          "keywords": ["prayer times", "Islamic", "Muslim", "Fajr", "Asr", "Qibla"],
          "smallIconUri": "https://praycalc.com/assets/alexa-icon-108.png",
          "largeIconUri": "https://praycalc.com/assets/alexa-icon-512.png"
        }
      },
      "isAvailableWorldwide": true,
      "testingInstructions": "Enable the skill, then say 'Alexa, open PrayCalc'. Say 'when is Asr', 'all prayer times', 'Qibla direction', or 'set my location to London'.",
      "category": "RELIGION_AND_SPIRITUALITY",
      "distributionCountries": []
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "https://praycalc.com/api/actions/alexa"
        },
        "regions": {
          "NA": {
            "endpoint": { "uri": "https://praycalc.com/api/actions/alexa" }
          },
          "EU": {
            "endpoint": { "uri": "https://praycalc.com/api/actions/alexa" }
          },
          "FE": {
            "endpoint": { "uri": "https://praycalc.com/api/actions/alexa" }
          }
        },
        "interfaces": [
          { "type": "ALEXA_PRESENTATION_APL" }
        ]
      }
    },
    "manifestVersion": "1.0",
    "permissions": [
      {
        "name": "alexa::devices:all:address:full:read"
      },
      {
        "name": "alexa::devices:all:geolocation:read"
      }
    ],
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": true,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "privacyPolicyUrl": "https://praycalc.com/privacy",
      "termsOfUseUrl":    "https://praycalc.com/terms",
      "locales": {
        "en-US": {
          "privacyPolicyUrl": "https://praycalc.com/privacy",
          "termsOfUseUrl":    "https://praycalc.com/terms"
        }
      }
    },
    "events": {
      "publications": [
        { "eventName": "AMAZON.PrayerTimesRequested" }
      ],
      "subscriptions": [
        { "eventName": "SKILL_ENABLED"  },
        { "eventName": "SKILL_DISABLED" }
      ],
      "endpoint": {
        "uri": "https://praycalc.com/api/actions/alexa"
      }
    }
  }
}
